{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10.1",
        "livewire/livewire": "^3.0",
        "mpdf/mpdf": "^8.2",
        "stancl/tenancy": "^3.10"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan metastyle:control:migrate --force",
            "@php artisan db:seed --force"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan serve"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest"
        ],
        "lint": [
            "@php vendor/bin/pint --test"
        ],
        "fix": [
            "@php vendor/bin/pint"
        ],
        "stan": [
            "@php vendor/bin/phpstan analyse --memory-limit=512M"
        ],
        "check": [
            "@lint",
            "@stan",
            "@test"
        ],
        "test:fast": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest tests/Architecture tests/Unit"
        ],
        "check:fast": [
            "@lint",
            "@stan",
            "@test:fast"
        ],
        "test:phase14": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest tests/Architecture tests/Unit tests/TenantIsolation tests/Feature/Reports tests/Feature/Usage tests/Feature/Reviews/RatingSummaryTest.php tests/Feature/Saas/TrialAndEntitlementTest.php tests/Feature/Identity/SystemRoleSyncTest.php tests/Feature/FoundationTest.php tests/Feature/ProductionReadinessTest.php"
        ],
        "check:phase14": [
            "@lint",
            "@stan",
            "@test:phase14"
        ],
        "test:phase15": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "@php vendor/bin/pest tests/Architecture tests/Unit tests/TenantIsolation tests/Feature/Phase15 tests/Feature/Manager tests/Feature/Saas tests/Feature/Identity tests/Feature/Booking tests/Feature/Journey tests/Feature/Queue tests/Feature/Conversations tests/Feature/Rayan tests/Feature/Customers tests/Feature/Loyalty tests/Feature/Memberships tests/Feature/Packages tests/Feature/Reviews tests/Feature/Employees tests/Feature/Resources tests/Feature/Catalog tests/Feature/Sales tests/Feature/Payments tests/Feature/Finance tests/Feature/Printing tests/Feature/Reports tests/Feature/Charts tests/Feature/Usage tests/Feature/Notifications tests/Feature/Menu tests/Feature/CenterSite tests/Feature/Media tests/Feature/Localization tests/Feature/FoundationTest.php tests/Feature/ProductionReadinessTest.php"
        ],
        "check:phase15": [
            "@lint",
            "@stan",
            "@test:phase15"
        ],
        "check:full": [
            "@check"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
