APP_NAME="Meta Style"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# APP_URL is the single domain authority. Its scheme, host and optional port
# produce the corporate, superadmin.* and center-slug.* subdomain origins.
METASTYLE_WILDCARD_DNS_READY=false
METASTYLE_WILDCARD_TLS_READY=false
METASTYLE_REGISTRATION_VERIFICATION_MINUTES=60

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# Meta Style has two data planes (docs/01-ARCHITECTURE.md §2).
#
#   control  the platform database
#   tenant   one database per tenant, bound at runtime — NEVER set a database
#            name for it here. See docs/02-TENANCY.md §4.
#
# MySQL 8 or MariaDB 10.4+. SQLite is not supported.

DB_CONNECTION=control

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

DB_CONTROL_DATABASE=meta_style_control

# Tenant databases may live on a different host from day one so they can be
# sharded later without a schema change (docs/DECISIONS.md ADR-004).
# DB_TENANT_HOST=127.0.0.1
# DB_TENANT_PORT=3306

# Advanced Reports read a separately operated reporting endpoint. The tenant
# database name is bound at runtime; never configure it here. These values may
# stay empty until Advanced Reports can be sold in this environment.
REPORTS_ADVANCED_ENABLED=false
# DB_REPORTING_HOST=127.0.0.1
# DB_REPORTING_PORT=3306
# DB_REPORTING_USERNAME=report_reader
# DB_REPORTING_PASSWORD=
# DB_REPORTING_SSL_CA=

# ---------------------------------------------------------------------------
# Drivers
# ---------------------------------------------------------------------------
# Phase 1 runs with no Redis and no extra services. Redis becomes the default
# in Phase 2, where tenant cache isolation and the provisioning queue make it
# worthwhile (docs/01-ARCHITECTURE.md §8).

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Database-backed so tenant context in queued jobs is real and testable
# without requiring Redis (ADR-025). Redis is the production driver.
QUEUE_CONNECTION=database

# MUST be a taggable store: tenant cache isolation works by tagging every
# entry with the tenant. `array` (local/test) and `redis` (production) support
# tags; `file` and `database` do NOT and will throw, which is correct — an
# untagged cache would serve one center's data to another (ADR-025).
CACHE_STORE=array

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# "structured" emits one JSON object per line with the correlation id and
# (from Phase 2) the tenant id, which is what makes per-tenant incidents
# diagnosable (docs/12-DEPLOYMENT-MIGRATION-STRATEGY.md §8).

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@metastyle.app"
MAIL_FROM_NAME="${APP_NAME}"

# Optional seed/bootstrap values are intentionally absent. Create platform
# users with the dedicated command so no administrator password is stored in
# environment files or source control.

# ---------------------------------------------------------------------------
# Booking verification pepper  (docs/24-BOOKING-VERIFICATION.md)
# ---------------------------------------------------------------------------
# Booking verification codes are stored as HMAC-SHA256 under a VERSIONED key.
# The raw code is never stored, so this pepper can never be "rehashed" away:
# rotation means adding v2, making it active, and keeping v1 for as long as
# codes written under it must still verify.
#
# NOT APP_KEY, deliberately. APP_KEY encrypts recoverable data and is rotated by
# re-encrypting it; this protects values that cannot be re-derived, so the two
# have different lifecycles. Coupling them would make an APP_KEY rotation
# silently invalidate every outstanding booking code.
#
# Generate with:  php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# `metastyle:doctor --production` FAILS if the active version is missing, has no
# key, or any configured key is shorter than 32 bytes.

BOOKING_VERIFICATION_ACTIVE_KEY=v1
BOOKING_VERIFICATION_KEY_V1=
# BOOKING_VERIFICATION_KEY_V2=

VITE_APP_NAME="${APP_NAME}"
