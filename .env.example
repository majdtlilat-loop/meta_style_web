APP_NAME="Meta Style"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
# Meta Style has two data planes (docs/01-ARCHITECTURE.md §2).
#
#   control  the platform database
#   tenant   one database per tenant, bound at runtime — NEVER set a database
#            name for it here. See docs/02-TENANCY.md §4.
#
# MySQL 8 or MariaDB 10.4+. SQLite is not supported.

DB_CONNECTION=control

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

DB_CONTROL_DATABASE=meta_style_control

# Tenant databases may live on a different host from day one so they can be
# sharded later without a schema change (docs/DECISIONS.md ADR-004).
# DB_TENANT_HOST=127.0.0.1
# DB_TENANT_PORT=3306

# ---------------------------------------------------------------------------
# Drivers
# ---------------------------------------------------------------------------
# Phase 1 runs with no Redis and no extra services. Redis becomes the default
# in Phase 2, where tenant cache isolation and the provisioning queue make it
# worthwhile (docs/01-ARCHITECTURE.md §8).

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Database-backed so tenant context in queued jobs is real and testable
# without requiring Redis (ADR-025). Redis is the production driver.
QUEUE_CONNECTION=database

# MUST be a taggable store: tenant cache isolation works by tagging every
# entry with the tenant. `array` (local/test) and `redis` (production) support
# tags; `file` and `database` do NOT and will throw, which is correct — an
# untagged cache would serve one center's data to another (ADR-025).
CACHE_STORE=array

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# "structured" emits one JSON object per line with the correlation id and
# (from Phase 2) the tenant id, which is what makes per-tenant incidents
# diagnosable (docs/12-DEPLOYMENT-MIGRATION-STRATEGY.md §8).

LOG_CHANNEL=stack
LOG_STACK=structured
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@metastyle.app"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
