<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <!-- Release gate. Never skipped. See docs/11-TESTING-STRATEGY.md §4. -->
        <testsuite name="TenantIsolation">
            <directory>tests/TenantIsolation</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The architecture suite parses every file under `app/` with
            nikic/php-parser, and the tree it builds is proportional to the
            codebase. XAMPP's default 512M was reached in Phase 11 and the run
            died mid-suite with a fatal error rather than a failure. Raised here
            rather than in the developer's php.ini, so every runner — Pest
            directly, `composer check:fast`, the phase gate and the full gate —
            gets the same ceiling. Nothing about what is tested changes.
        -->
        <ini name="memory_limit" value="2G"/>

        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>

        <!--
            Tests run against a REAL MySQL-compatible server. SQLite is not a
            substitute: this system depends on MySQL JSON functions, generated
            columns, collation and foreign key semantics, and a suite that is
            green on SQLite and broken in production is worse than no suite.
            See docs/11-TESTING-STRATEGY.md §2 and docs/DECISIONS.md ADR-016.

            There is no `tenant` connection here either: it is created at
            runtime only while a tenant is initialised, so an unbound query
            fails immediately.
        -->
        <env name="DB_CONNECTION" value="control"/>
        <env name="DB_CONTROL_DATABASE" value="meta_style_test_control"/>

        <!--
            Tenant databases created by the suite carry the test prefix, so
            they can never collide with, or be mistaken for, a developer's real
            tenant databases. TestDatabaseManager refuses to drop anything
            without it.
        -->
        <env name="METASTYLE_TENANT_DB_PREFIX" value="meta_style_test_t"/>

        <!--
            The booking-verification pepper (docs/24-BOOKING-VERIFICATION.md §4).

            A FIXED, PUBLICLY VISIBLE TEST KEY, and that is the point: the suite
            asserts that a specific code verifies and a plain SHA-256 of the same
            code does NOT match what is stored, which needs a key the test can
            reason about. It is 32 bytes so the production doctor's length rule
            is exercised by the same value every run.

            No production secret is ever read from here, and nothing outside the
            test database is encrypted with it.
        -->
        <env name="BOOKING_VERIFICATION_ACTIVE_KEY" value="v1"/>
        <env name="BOOKING_VERIFICATION_KEY_V1" value="base64:dGVzdC1vbmx5LWJvb2tpbmctdmVyaWZpY2F0aW9uLWsx"/>

        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="database"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="LOG_STACK" value="single"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
